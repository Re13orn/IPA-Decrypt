+std::string exchange_error_code(ByteView body) {
+    if (body.empty() || body.size() > 16 * 1024) {
+        return {};
+    }
+    const auto response = Json::parse(body.begin(), body.end(), nullptr, false);
+    if (!response.is_object()) {
+        return {};
+    }
+    const auto numeric = [](const std::string& code) {
+        const auto start = code.starts_with('-') ? 1u : 0u;
+        return code.size() > start && code.size() - start <= 7 &&
+               code.find_first_not_of("0123456789", start) == std::string::npos;
+    };
+    auto code = text(response, "errorCode");
+    if (numeric(code)) {
+        return " Apple error " + code;
+    }
+    if (response.contains("error")) {
+        code = text(response.at("error"), "code");
+        if (numeric(code)) {
+            return " Apple error " + code;
+        }
+    }
+    if (response.contains("messages") && response.at("messages").is_array()) {
+        for (const auto& message : response.at("messages")) {
+            code = text(message, "code");
+            if (text(message, "messageType") == "ERROR" && numeric(code)) {
+                return " Apple error " + code;
+            }
+        }
+    }
+    return {};
+}
